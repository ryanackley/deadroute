# Anthropic API key for Claude Agent SDK
ANTHROPIC_API_KEY=your-api-key-here

# OpenAI API key for Vectra embeddings
OPENAI_API_KEY=your-openai-api-key-here

# Models (optional overrides)
# PLANNER_MODEL=claude-sonnet-4-5-20250929
# PERSONA_MODEL=claude-haiku-4-5-20251001

# Generation settings (optional)
# START_DATE=2024-01-15
# SIMULATION_DAYS=250
# OUTPUT_DIR=./output

# Atlassian Cloud bootstrapper (for npm run bootstrap)
# ATLASSIAN_HOST=https://your-site.atlassian.net
# ATLASSIAN_ADMIN_EMAIL=admin@example.com
# ATLASSIAN_ADMIN_API_TOKEN=your-api-token

# ── Factory mode (npm run factory) ──
# The human CEO's Atlassian account = ATLASSIAN_ADMIN_EMAIL/TOKEN above.
# GitHub repo the AI team builds in:
# GITHUB_OWNER=your-github-user
# GITHUB_REPO=your-product-repo
# GITHUB_DEFAULT_BRANCH=main
# Per-dev GitHub personal access tokens (repo scope):
# GITHUB_PAT_DEV_LEAD=ghp_...
# GITHUB_PAT_DEV1=ghp_...
# GITHUB_PAT_DEV2=ghp_...
# Optional factory tuning:
# FACTORY_COMPANY_NAME=DeadRoute
# FACTORY_COMPANY_PROFILE=./company-profile.md  # editable backstory injected into every agent
# FACTORY_WORKSPACES_DIR=./factory-workspaces
# FACTORY_AGENT_MODEL=claude-sonnet-4-6
# FACTORY_MAX_AGENT_TURNS=100
# FACTORY_MAX_REVIEW_ROUNDS=3
# FACTORY_MAX_FIX_ROUNDS=3
# FACTORY_SANDBOX=true
# FACTORY_CEO_ACCOUNT_ID=  # override if CEO ≠ admin account
